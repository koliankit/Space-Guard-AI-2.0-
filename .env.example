# ==============================================================================
# ASTRA VIGIL — Private On-Premise Environment Configuration (.env.example)
# Copy this file to .env and adjust credentials for production deployment.
# NEVER commit .env containing real passwords to public git repositories.
# ==============================================================================

# Database Configuration (PostgreSQL in container)
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_change_in_production_2026!
POSTGRES_DB=astra_vigil

# Application Database Connection String
DATABASE_URL=postgresql://astra:astra_change_in_production_2026!@db:5432/astra_vigil
# For SQLite local execution without Docker:
# DATABASE_URL=sqlite:///./spaceguard.db

# Cryptographic Security Key for JWT signing (Minimum 32 random characters in prod)
ASTRA_SECRET_KEY=generate_a_secure_random_hex_string_for_production_here

# Default Pre-Provisioned Flight Qualification Account Passwords
ASTRA_ADMIN_PWD=AdminSecurePass#2026
ASTRA_ENG_PWD=EngineerFlightPass#2026
ASTRA_ANALYST_PWD=AnalystScreeningPass#2026
ASTRA_VIEWER_PWD=ViewerAuditPass#2026

# Network / Port Bindings
BACKEND_PORT=8000
FRONTEND_PORT=80

# ==============================================================================
# Trusted Execution Environment (TEE) Confidential Computing Layer
# ==============================================================================
# Master toggle for TEE protected execution (true/false)
TEE_ENABLED=true

# Execution Mode: "simulation" (local development / testing) | "production" (hardware enclave)
TEE_MODE=simulation

# Strict Hardware Requirement: if true, simulation cannot satisfy TEE policy
TEE_REQUIRE_HARDWARE=false

# Fallback Policy: whether standard (unprotected) execution is allowed if TEE is offline/fails
TEE_FALLBACK_ALLOWED=true

# Enclave Identifier & Cryptographic Secret for Attestation Signing
TEE_ENCLAVE_ID=spaceguard-tee-enclave-sim-01
TEE_ATTESTATION_SECRET=spaceguard-tee-attestation-hmac-secret-v1

